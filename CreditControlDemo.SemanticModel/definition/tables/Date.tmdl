	column 'Is Month End'
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: c5d661ae-1319-4a5a-9ec2-fcddea2c3834
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Month End]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				
				VAR FirstActivity = MIN ( Invoices[InvoiceDate] )
				VAR LastActivity = MAX ( MAX ( Invoices[InvoiceDate] ), MAX ( Allocations[AllocationDate] ) )
				VAR StartDate = DATE ( YEAR ( EDATE ( FirstActivity, -3 ) ), 4, 1 )
				VAR EndDate = EOMONTH ( LastActivity, 1 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( StartDate, EndDate ),
				        "Year", YEAR ( [Date] ),
				        "MonthNo", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM" ),
				        "Year Month", FORMAT ( [Date], "MMM yyyy" ),
				        "YearMonthKey", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Fiscal Year",
				            VAR FyStart = YEAR ( EDATE ( [Date], -3 ) )
				            RETURN "FY" & FyStart & "/" & RIGHT ( FyStart + 1, 2 ),
				        "Month End", EOMONTH ( [Date], 0 ),
				        "Is Month End", [Date] = EOMONTH ( [Date], 0 )
				    )

	annotation PBI_Id = 2507e1fbb6f2453c916a762e2892e883

